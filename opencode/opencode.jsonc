{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "build",
  "snapshot": false,
  "snapshots": false,
  "small_model": "opencode-go/mimo-v2.5-free",
  "model": "opencode-go/nemotron-3.5-lightning-free",
  "permission": {
    "*": "allow",
    "bash": "allow",
    "shell": "allow",
    "sudo": "allow",
    "edit": "allow",
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "task": "allow",
    "skill": "allow",
    "lsp": "allow",
    "todowrite": "allow",
    "question": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "external_directory": "allow",
    "doom_loop": "allow"
  },
  "tools": {
    "github_*": false
  },
  "agent": {
    "build": {
      "mode": "primary",
      "permission": {
        "*": "allow",
        "bash": "allow",
        "shell": "allow",
        "sudo": "allow",
        "edit": "allow",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "task": "allow",
        "skill": "allow",
        "lsp": "allow",
        "todowrite": "allow",
        "question": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "external_directory": "allow",
        "doom_loop": "allow"
      }
    },
    "yolo": {
      "description": "Autonomous agent with auto-approve permissions and YOLO mode",
      "mode": "primary",
      "permission": {
        "*": "allow",
        "bash": "allow",
        "shell": "allow",
        "sudo": "allow",
        "edit": "allow",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "task": "allow",
        "skill": "allow",
        "lsp": "allow",
        "todowrite": "allow",
        "question": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "external_directory": "allow",
        "doom_loop": "allow"
      }
    },
    "repo-helper": {
      "description": "Repo chores with GitHub MCP tools (issues, PRs, Actions logs)",
      "mode": "subagent",
      "tools": {
        "github_*": true
      },
      "prompt": "You handle GitHub repo chores: issues, pull requests, code search, Actions logs. Use github_* MCP tools. Be concise and cite file:line or URLs."
    }
  },
  "plugin": [
    "@frankhommers/opencode-yolo",
    "file:///home/x3/.config/opencode/plugins/rtk.ts",
    "file:///home/x3/.config/opencode/plugins/freebuff-plugin.ts",
    "superpowers@git+https://github.com/obra/superpowers.git",
    "./plugins/caveman/plugin.js"
  ],
  "provider": {
    "owl": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OWL-Agent (local :60000 proxy pool)",
      "options": {
        "baseURL": "http://127.0.0.1:60000/v1",
        "apiKey": "{env:OWL_API_KEY}"
      },
      "models": {
        "owl-auto-racer": {
          "name": "OWL Auto Racer (free, stream-raced)"
        }
      }
    },
    "freebuff": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Freebuff Unified (local :18080 passthrough)",
      "options": {
        "baseURL": "http://127.0.0.1:18080/v1",
        "apiKey": "{env:FREEBUFF_API_KEY}"
      },
      "models": {
        "z-ai/glm-5.3-flash": {
          "name": "GLM 5.3 Flash (free, 1M ctx, reasoning)"
        },
        "deepseek/deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash (free, reasoning)"
        },
        "mimo/mimo-v2.5": {
          "name": "MiMo 2.5 (free)"
        }
      }
    },
    "cloudflare": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Cloudflare Workers AI",
      "options": {
        "baseURL": "https://api.cloudflare.com/client/v4/accounts/{env:CLOUDFLARE_ACCOUNT_ID}/ai/v1",
        "apiKey": "{env:CLOUDFLARE_API_KEY}"
      },
      "models": {
        "llama-3.1-8b-instruct-fast": {
          "name": "Cloudflare Llama 3.1 8B Fast",
          "id": "@cf/meta/llama-3.1-8b-instruct-fast"
        },
        "llama-3.2-3b-instruct": {
          "name": "Cloudflare Llama 3.2 3B",
          "id": "@cf/meta/llama-3.2-3b-instruct"
        },
        "llama-4-scout-17b-16e-instruct": {
          "name": "Cloudflare Llama 4 Scout",
          "id": "@cf/meta/llama-4-scout-17b-16e-instruct"
        },
        "mistral-small-3.1-24b-instruct": {
          "name": "Cloudflare Mistral Small 3.1",
          "id": "@cf/mistralai/mistral-small-3.1-24b-instruct"
        }
      }
    },
    "ollama": {
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "heretic-qwen3-0.6b": {
          "name": "Heretic Qwen3 0.6B (uncensored, 396MB, local)"
        },
        "qwen2.5:3b": {
          "name": "Qwen 2.5 3B (local)"
        },
        "deepseek-r1:1.5b": {
          "name": "DeepSeek R1 1.5B (local)"
        },
        "gemma4:e2b": {
          "name": "Gemma 4 E2B (local)"
        }
      }
    },
    "opencode": {
      "whitelist": [
        "deepseek-v4-flash-free",
        "mimo-v2.5-free",
        "ling-3.0-flash-fin-free",
        "nemotron-3-ultra-free",
        "nemotron-3.5-lightning-free",
        "muse-spark-1.3-contributor-free",
        "muse-spark-1.2-contributor-free"
      ]
    },
    "opencode-go": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OpenCode Go (Zen $10 plan, free-tier routing)",
      "options": {
        "baseURL": "https://opencode.ai/zen/v1",
        "apiKey": "{env:OPENCODE_GO_UKAJ}"
      },
      "models": {
        "deepseek-v4-flash-free": {
          "name": "DeepSeek V4 Flash (free)"
        },
        "mimo-v2.5-free": {
          "name": "MiMo 2.5 (free)"
        },
        "ling-3.0-flash-fin-free": {
          "name": "Ling 3.0 Flash Fin (free)"
        },
        "nemotron-3-ultra-free": {
          "name": "Nemotron 3 Ultra (free)"
        },
        "nemotron-3.5-lightning-free": {
          "name": "Nemotron 3.5 Lightning (free)"
        },
        "muse-spark-1.3-contributor-free": {
          "name": "Muse Spark 1.3 Contributor (free)"
        },
        "muse-spark-1.2-contributor-free": {
          "name": "Muse Spark 1.2 Contributor (free)"
        }
      }
    },
    "blacklisted": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "BlacklistedAIProxy (free model gateway)",
      "options": {
        "baseURL": "http://127.0.0.1:3005/v1",
        "apiKey": "{env:BAP_GATEWAY_KEY}"
      },
      "models": {
        "glm-4.7-flash-via-zhipu": {
          "name": "GLM 4.7 Flash (Zhipu free)"
        },
        "claude-sonnet-4-5-20250929": {
          "name": "Claude Sonnet 4.5 (KiroPool)"
        },
        "claude-opus-4-7": {
          "name": "Claude Opus 4.7 (KiroPool)"
        },
        "gemini-3-flash": {
          "name": "Gemini 3 Flash (Antigravity)"
        },
        "grok4.6": {
          "name": "Grok 4.6 (grok2api)"
        },
        "groq-qwen": {
          "name": "Qwen 3.8 27B (Groq)"
        },
        "command-a": {
          "name": "Command A+ (Cohere)"
        },
        "openai/gpt-oss-20b": {
          "name": "GPT-OSS 20B (NVIDIA NIM)"
        },
        "nvidia/nemotron-3-super-120b-a12b": {
          "name": "Nemotron 3 Super 120B (NVIDIA NIM)"
        },
        "z-ai/glm-5.3-flash": {
          "name": "GLM 5.3 Flash (NVIDIA NIM)"
        },
        "deepseek-ai/deepseek-v4-flash-0731": {
          "name": "DeepSeek V4 Flash (NVIDIA NIM)"
        }
      }
    }
  },
  "enabled_providers": [
    "owl",
    "freebuff",
    "cloudflare",
    "ollama",
    "opencode",
    "opencode-go",
    "blacklisted"
  ],
  "disabled_providers": [
    "autoclaw",
    "nvidia"
  ],
  "mcp": {
    "serena": {
      "type": "local",
      "command": [
        "uvx",
        "--from",
        "serena-agent",
        "serena",
        "start-mcp-server",
        "--project-from-cwd",
        "--context",
        "agent",
        "--open-web-dashboard",
        "False"
      ],
      "enabled": false
    },
    "headroom": {
      "type": "local",
      "command": [
        "/home/x3/.local/bin/headroom",
        "mcp",
        "serve"
      ],
      "enabled": true
    },
    "skillspector": {
      "type": "local",
      "command": [
        "/home/x3/aiworkspace/integrations/SkillSpector/.venv/bin/skillspector",
        "mcp"
      ],
      "enabled": false
    },
    "ruv-swarm": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "ruv-swarm",
        "mcp",
        "start"
      ],
      "enabled": false
    },
    "filesystem": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "."
      ],
      "enabled": false
    },
    "github": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "enabled": true,
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GITHUB_PAT}"
      }
    },
    "octocode": {
      "type": "local",
      "command": [
        "node",
        "/home/x3/.npm/_npx/083fb27bda2f3c42/node_modules/octocode-mcp/dist/index.js"
      ],
      "enabled": true,
      "env": {
        "GITHUB_TOKEN": "{env:GITHUB_PAT}"
      }
    },
    "memory": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-memory"
      ],
      "enabled": false
    },
    "parallel-search": {
      "type": "remote",
      "url": "https://search.parallel.ai/mcp",
      "enabled": true
    },
    "graphify": {
      "type": "local",
      "command": [
        "/home/x3/.local/bin/graphify-mcp"
      ],
      "enabled": true
    },
    "owl_dns_synergy": {
      "type": "local",
      "command": [
        "python3",
        "-m",
        "owl_dns_synergy.cli",
        "serve",
        "--host",
        "127.0.0.1",
        "--port",
        "60000"
      ],
      "enabled": false,
      "cwd": "/home/x3/workspace/unified-owl",
      "description": "DNS tunneling server, NOT MCP. Use owl_resilient for MCP tools."
    },
    "owl_resilient": {
      "type": "local",
      "command": [
        "python3",
        "/home/x3/workspace/unified-owl/owl_resilient_mcp.py"
      ],
      "enabled": true,
      "cwd": "/home/x3/workspace/unified-owl"
    },
    "slipgate": {
      "type": "local",
      "command": [
        "slipgate"
      ],
      "enabled": false,
      "cwd": "/tmp/slipgate",
      "description": "Unified tunnel manager - DNS tunnels + HTTPS proxies (NaiveProxy) + systemd + user management + slipnet:// URIs",
      "notes": "Alternative to owl_dns_synergy; supports DNSTT/NoizDNS/Slipstream/VayDNS tunnels + NaiveProxy HTTPS + StunTLS SSH+WS + SOCKS5 + TUI dashboard + systemd services",
      "prerequisites": "Domain A record pointing at server; ports 53/udp (DNS), 443/tcp (NaiveProxy)",
      "install": "curl -fsSL https://raw.githubusercontent.com/anonvector/slipgate/main/install.sh | sudo bash"
    }
  },
  "instructions": [
    "AGENTS.md"
  ],
  "skills": {}
}