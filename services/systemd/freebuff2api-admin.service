[Unit]
Description=Freebuff2API Admin Panel
After=network.target freebuff2api.service
Wants=freebuff2api.service

[Service]
Type=simple
User=freebuff
Group=freebuff
WorkingDirectory=/opt/freebuff/python/Freebuff2API-Optimized/admin
ExecStart=/opt/freebuff/python/Freebuff2API-Optimized/admin/venv/bin/python backend/main.py
Restart=always
RestartSec=5
Environment=PATH=/opt/freebuff/python/Freebuff2API-Optimized/admin/venv/bin:/usr/local/bin:/usr/bin:/bin
Environment=HOME=/opt/freebuff
Environment=FREEBUFF2API_DATA_DIR=/opt/freebuff/.freebuff2api
Environment=FREEBUFF2API_URL=http://127.0.0.1:20004
StandardOutput=journal
StandardError=journal
SyslogIdentifier=freebuff2api-admin

[Install]
WantedBy=multi-user.target
