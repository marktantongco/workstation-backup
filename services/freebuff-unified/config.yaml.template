server:
  listen: ":18080"
  auto_approve: true
  api_keys:
    - "<REPLACE_ME>"
    - "<REPLACE_ME>"

upstream:
  base_url: "https://www.codebuff.com"
  cost_mode: "free"
  default_model: "deepseek/deepseek-v4-pro"

auth:
  api_keys:
    - "<REPLACE_ME>"
    - "<REPLACE_ME>"
  dir: "auths"
  breaker:
    threshold: 3
    cooldown: 12h

stealth:
  strip_headers: true
  enabled: false
  # Pool DISABLED 2026-09-14: direct egress ~0.3s TTFB vs 0.36-1.9s through the
  # public SOCKS5 pool (5x slower typical; dead picks = user-visible timeouts).
  # NOTE: the gateway builds USProxyPool whenever us_proxies is non-empty —
  # auto_refresh_pool only gates the Hermes refresher, not the pool itself.
  # To re-enable with free lists (monosans hour-checked / TheSpeedX volume):
  #   proxy_url: "https://raw.githubusercontent.com/monosans/proxy-list/main/proxies/socks5.txt"
  #   proxy_url: "https://raw.githubusercontent.com/TheSpeedX/SOCKS-List/master/socks5.txt"
  # (plain host:port and socks5://host:port lines are now parsed natively)
  # Or swap for a paid Webshare list (host:port:user:pass:country).
  auto_refresh_pool: false
  proxy_refresh_mins: 30
  max_pool_proxies: 12
  profile: "chrome120"
  us_proxies: []
  # SOCKS5 proxy pool (Webshare format: host:port:user:pass:country)
  # proxy_url: "http://example.com/proxies.txt"
  # proxy_refresh_mins: 30
  # strict_geo: false
  # geo_verify: false
  # searxng_url: "http://127.0.0.1:8888"
  # Set SEARXNG_URL env to override

limits:
  global_rpm: 120
  account_rpm: 30
  client_rpm: 60

# Front-door mode: transparently forwards /v1/* to a freebuff-proxy backend
proxy:
  enabled: true
  backend_url: "http://127.0.0.1:3457"
  mode: "passthrough"

# Dashboard (freebuff-proxy pattern)
dashboard:
  enabled: true
  addr: ":9091"
  prefix: "/dashboard"

# Hermes stealth sidecar (kori-lab/hermes vendored under deps/hermes)
# TLS 1.3 / HTTP2 stealth requests via local Node service on :3101
hermes:
  enabled: true
  base_url: "http://127.0.0.1:3101"

parallel:
  enabled: true
  base_url: "https://api.parallel.ai"
  default_mode: "fast"
  default_processor: "pro-fast"
  # api_key: read from PARALLEL_API_KEY env when omitted (keyless-first:
  # deep-research + /v1/responses try without a key and fall back to native)

research:
  enabled: true
  max_queries: 5
  fan_out: 8
  extract_per_query: 3
  timeout_ms: 300000

logging:
  level: "info"
