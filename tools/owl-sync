#!/usr/bin/env bash
# owl-sync — single-source-of-truth sync for unified-owl → x1 + root installs
#
# Source of truth: $SOURCE_DIR (default: ~/workspace/unified-owl)
# Live install:     $X1_DIR    (default: /home/x1/.owl-agent) — systemd ExecStart
# Legacy install:   $ROOT_DIR  (default: /root/.owl-agent)   — old ExecStart path
#
# Usage:
#   owl-sync                # idempotent sync (only copies changed files)
#   owl-sync --restart     # sync + restart owl-agent.service
#   owl-sync --dry-run     # show what would change, don't copy
#   owl-sync --verify      # check current state (no changes)
#
# Idempotent: skips files where md5 already matches. Permission-safe:
# copies to x1 dir as x1 user, to root dir as root. Plugins dir uses rsync.
#
# Requires sudo (NOPASSWD or password prompt) for the root target.

set -uo pipefail

SOURCE_DIR="${SOURCE_DIR:-$HOME/workspace/unified-owl}"
X1_DIR="${X1_DIR:-/home/x1/.owl-agent}"
ROOT_DIR="${ROOT_DIR:-/root/.owl-agent}"
SERVICE="owl-agent.service"
LOG_FILE="${LOG_FILE:-$HOME/.local/share/owl-sync.log}"

# Files we treat as canonical from unified-owl
PY_FILES=(owl_server.py proxy_defense.py chameleon_ai.py forward_proxy.py owl_resilient_mcp.py)
SUBDIRS=(plugins)

mkdir -p "$(dirname "$LOG_FILE")"

log() { printf '%s %s\n' "$(date -Iseconds 2>/dev/null || date)" "$*" | tee -a "$LOG_FILE" ; }

DRY_RUN=0
DO_RESTART=0
VERIFY_ONLY=0
for arg in "$@"; do
    case "$arg" in
        --dry-run)    DRY_RUN=1 ;;
        --restart)    DO_RESTART=1 ;;
        --verify)     VERIFY_ONLY=1 ;;
        -h|--help)
            sed -n '2,20p' "$0" | sed 's/^# \?//'
            exit 0 ;;
        *) log "unknown arg: $arg"; exit 2 ;;
    esac
done

[[ -d "$SOURCE_DIR" ]] || { log "FATAL: source missing: $SOURCE_DIR"; exit 1; }

# --- helpers --------------------------------------------------------------

md5_of() { md5sum "$1" 2>/dev/null | awk '{print $1}'; }

copy_one() {
    local src="$1" dst="$2" label="$3"
    local src_md5 dst_md5
    src_md5=$(md5_of "$src")
    dst_md5=$(md5_of "$dst")
    if [[ "$src_md5" == "$dst_md5" ]]; then
        log "[skip] $label $(basename "$src") (md5 match)"
        return 0
    fi
    if [[ "$DRY_RUN" -eq 1 ]]; then
        log "[would-copy] $label $(basename "$src") ($src_md5 → $dst)"
        return 0
    fi
    if cp "$src" "$dst"; then
        log "[copy] $label $(basename "$src") ($src_md5 → $(md5_of "$dst"))"
    else
        log "[FAIL] $label $(basename "$src") (cp exit=$?)"
        return 1
    fi
}

# Per-target copy: choose uid based on target dir owner
copy_to() {
    local target_root="$1" label="$2"
    # Test for existence + ownership as root so we can see x1-owned dirs.
    if ! sudo -n test -d "$target_root" 2>/dev/null; then
        log "[skip] $label dir missing ($target_root)"
        return 0
    fi
    local owner
    owner=$(sudo -n stat -c '%U' "$target_root" 2>/dev/null || echo "root")
    for f in "${PY_FILES[@]}"; do
        [[ -f "$SOURCE_DIR/$f" ]] || { log "[skip] $label $f (source missing)"; continue; }
        if [[ "$owner" == "root" ]]; then
            sudo -n cp "$SOURCE_DIR/$f" "$target_root/$f" 2>/dev/null \
              || cp "$SOURCE_DIR/$f" "$target_root/$f"
        else
            sudo -u "$owner" cp "$SOURCE_DIR/$f" "$target_root/$f" 2>/dev/null \
              || cp "$SOURCE_DIR/$f" "$target_root/$f"
        fi
        chmod a+r "$target_root/$f" 2>/dev/null
    done
    if [[ -d "$SOURCE_DIR/plugins" ]]; then
        if [[ "$owner" == "root" ]]; then
            sudo -n rsync -a --delete "$SOURCE_DIR/plugins/" "$target_root/plugins/" 2>/dev/null \
              || rsync -a --delete "$SOURCE_DIR/plugins/" "$target_root/plugins/"
        else
            sudo -u "$owner" rsync -a --delete "$SOURCE_DIR/plugins/" "$target_root/plugins/" 2>/dev/null \
              || rsync -a --delete "$SOURCE_DIR/plugins/" "$target_root/plugins/"
        fi
        log "[plugins] synced to $label ($target_root/plugins/)"
    fi
}

verify_state() {
    log "=== verify ==="
    local drift=0
    for f in "${PY_FILES[@]}"; do
        local s x r
        s=$(md5_of "$SOURCE_DIR/$f" 2>/dev/null || echo "missing")
        # Read x1/root targets as root to bypass perms.
        if sudo -n test -f "$X1_DIR/$f" 2>/dev/null; then
            x=$(sudo -n md5sum "$X1_DIR/$f" 2>/dev/null | awk '{print $1}')
        else
            x="missing"
        fi
        if sudo -n test -f "$ROOT_DIR/$f" 2>/dev/null; then
            r=$(sudo -n md5sum "$ROOT_DIR/$f" 2>/dev/null | awk '{print $1}')
        else
            r="missing"
        fi
        if [[ "$s" == "$x" && "$s" == "$r" ]]; then
            log "OK   $f (all 3 match: ${s:0:8})"
        else
            log "DRIFT $f  src=${s:0:8} x1=${x:0:8} root=${r:0:8}"
            drift=$((drift+1))
        fi
    done
    if [[ -d "$SOURCE_DIR/plugins" ]]; then
        local s_n=$(find "$SOURCE_DIR/plugins" -type f 2>/dev/null | wc -l)
        local x_n=$(sudo -n find "$X1_DIR/plugins" -type f 2>/dev/null | wc -l)
        local r_n=$(sudo -n find "$ROOT_DIR/plugins" -type f 2>/dev/null | wc -l)
        log "plugins: src=$s_n files x1=$x_n root=$r_n"
    fi
    return $drift
}

restart_service() {
    log "[restart] stopping $SERVICE (clears port collision)"
    sudo -n systemctl stop "$SERVICE" 2>&1 | head -n 3
    for i in 1 2 3 4 5; do
        sudo -n pkill -9 -f "owl-agent/owl_server.py" 2>/dev/null
        sleep 2
    done
    sudo -n systemctl reset-failed "$SERVICE" 2>&1 | head -n 1
    sudo -n systemctl daemon-reload 2>&1 | head -n 1
    sudo -n systemctl start "$SERVICE" 2>&1 | head -n 3
    sleep 5
    local active pid
    active=$(sudo -n systemctl is-active "$SERVICE" 2>&1)
    pid=$(sudo -n ss -tlnp 2>/dev/null | awk '/:60000/{for(i=1;i<=NF;i++)if($i~/pid=/){gsub(/[^0-9]/,"",$i);print $i;exit}}')
    log "[restart] status=$active pid=$pid"
}

# --- main -----------------------------------------------------------------

log "=== owl-sync source=$SOURCE_DIR → x1=$X1_DIR root=$ROOT_DIR ==="

if [[ "$VERIFY_ONLY" -eq 1 ]]; then
    verify_state
    exit $?
fi

copy_to "$X1_DIR" "x1"
copy_to "$ROOT_DIR" "root"

# Post-sync verify
verify_state
verify_rc=$?

if [[ "$verify_rc" -ne 0 && "$DRY_RUN" -eq 1 ]]; then
    log "DRY-RUN: drift would remain after copy attempt"
fi

if [[ "$DO_RESTART" -eq 1 && "$DRY_RUN" -eq 0 ]]; then
    restart_service
fi

log "=== owl-sync done ==="
exit 0
